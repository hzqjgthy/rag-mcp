# RAG-MCP 中国本地化环境变量配置
# 复制此文件为 .env.china 并填入您的实际值
# 不要将包含真实API密钥的文件提交到版本控制

# ==================== LLM配置 ====================
# LLM提供商: deepseek, zhipu, qwen, moonshot
CHINA_LLM_PROVIDER=deepseek

# LLM API密钥 (必需)
CHINA_LLM_API_KEY=your_api_key_here

# LLM API基础URL (可选，会根据提供商自动设置)
# CHINA_LLM_BASE_URL=https://api.deepseek.com

# 模型名称 (可选，会根据提供商自动设置)
# CHINA_LLM_MODEL=deepseek-chat

# 最大生成令牌数
CHINA_LLM_MAX_TOKENS=4096

# 生成温度 (0.0-1.0)
CHINA_LLM_TEMPERATURE=0.7

# ==================== 向量数据库配置 ====================
# 向量数据库类型: chromadb, faiss
CHINA_VECTOR_DB_TYPE=chromadb

# 数据库持久化路径
CHINA_VECTOR_DB_PATH=./china_vector_db

# 集合名称
CHINA_VECTOR_COLLECTION=rag_mcp_tools_cn

# 嵌入模型 (中文优化)
CHINA_EMBEDDING_MODEL=shibing624/text2vec-base-chinese

# 最大检索结果数
CHINA_VECTOR_MAX_RESULTS=10

# ==================== MCP配置 ====================
# MCP命令
CHINA_MCP_COMMAND=npx

# MCP参数 (逗号分隔)
CHINA_MCP_ARGS=-y,@modelcontextprotocol/server-filesystem,.

# ==================== 聊天配置 ====================
# 最大工具调用轮数
CHINA_CHAT_MAX_TOOL_ROUNDS=5

# 启用自动工具调用
CHINA_CHAT_ENABLE_AUTO_TOOLS=true

# 启用中文优化 (分词、语义等)
CHINA_ENABLE_CHINESE_OPT=true

# ==================== 提供商配置说明 ====================
# 
# DeepSeek (推荐)
# - 网站: https://platform.deepseek.com/
# - 模型: deepseek-chat, deepseek-coder
# - 特点: 长上下文，性价比高
#
# 智谱AI
# - 网站: https://open.bigmodel.cn/
# - 模型: glm-4, glm-3-turbo
# - 特点: 清华技术，中文理解好
#
# 通义千问
# - 网站: https://dashscope.aliyuncs.com/
# - 模型: qwen-turbo, qwen-plus, qwen-max
# - 特点: 阿里云服务，稳定可靠
#
# Moonshot AI
# - 网站: https://platform.moonshot.cn/
# - 模型: moonshot-v1-8k, moonshot-v1-32k, moonshot-v1-128k
# - 特点: 超长上下文，Kimi大模型

# ==================== 使用示例 ====================
#
# 1. 基础使用 (仅LLM对话)
#    python china_cli.py chat --provider deepseek --api-key YOUR_KEY --disable-mcp
#
# 2. 完整功能 (LLM + 向量数据库 + MCP工具)
#    python china_cli.py chat --provider deepseek --api-key YOUR_KEY
#
# 3. 快速启动
#    python china_cli.py quick-start --provider deepseek --api-key YOUR_KEY
#
# 4. 测试连接
#    python china_cli.py chat --provider deepseek --api-key YOUR_KEY --test-only
#
# 5. 查看支持的提供商
#    python china_cli.py chat --list-providers 